{
  "name": "dsh-plugin-template",
  "version": "0.1.0",
  "description": "A starter template for DeepSeek Harness (dsh) plugins: config + tool + events + service in one installable bundle.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./service": {
      "types": "./lib/service.d.ts",
      "default": "./lib/service.js"
    },
    "./hook": {
      "types": "./lib/hook.d.ts",
      "default": "./lib/hook.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/service.js",
    "lib/hook.js",
    "lib/index.d.ts",
    "lib/service.d.ts",
    "lib/hook.d.ts",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf lib",
    "smoke": "node test/smoke.mjs",
    "test": "pnpm build && node test/smoke.mjs",
    "prepare": "tsdown"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "template"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  }
}
